def main():
    # Under the forced command the request is in the environment, not argv.
    raw = os.environ.get("SSH_ORIGINAL_COMMAND")
    if raw is None and len(sys.argv) > 1 and sys.argv[1].startswith("--"):
        sys.exit(admin(sys.argv[1:]))
    if raw is None:
        raw = " ".join(sys.argv[1:])          # direct invocation, for testing
    raw = (raw or "").strip() or "ping"

    try:
        parts = shlex.split(raw)
    except ValueError as e:
        fail(f"could not parse request: {e}")
        return
    if not parts:
        fail("empty request")
        return

    verb, args = parts[0], parts[1:]
    if len(args) > 4 or any(len(a) > 128 for a in args):
        fail("request rejected: too many or over-long arguments")
        return

    handler = COMMANDS.get(verb)
    if handler is None:
        fail(f"unknown subcommand {verb!r}", allowed=sorted(COMMANDS))
        return

    cfg = conf()
    try:
        result = handler(cfg, args)
    except Exception as e:                                    # noqa: BLE001
        fail(f"{verb}: {type(e).__name__}: {e}")
        return
    if cfg.get("_conf_error"):
        result["conf_error"] = cfg["_conf_error"]
    out(result)


if __name__ == "__main__":
    main()
