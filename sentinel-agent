def is_lifeline(unit):
    return bool(LIFELINE_RE.fullmatch(unit or ""))


def control_units(cfg):
    if not cfg.get("allow_control"):
        return []
    watched = set(cfg["units"])
    return [u for u in (cfg.get("control") or {}).get("units", []) or []
            if isinstance(u, str) and UNIT_RE.fullmatch(u) and u in watched]


def check_container_names(cfg):
    """Containers a check runs in: never started, stopped or restarted bare."""
    names = set()
    for spec in check_control_specs(cfg).values():
        c = spec.get("container")
        if isinstance(c, str) and CONTAINER_RE.fullmatch(c):
            names.add(c)
    return names


def control_containers(cfg):
    if not cfg.get("allow_control"):
        return []
    watched = set(cfg["containers"])
    guarded = check_container_names(cfg)
    return [c for c in (cfg.get("control") or {}).get("containers", []) or []
            if isinstance(c, str) and CONTAINER_RE.fullmatch(c) and c in watched and c not in guarded]


def unit_verbs(unit):
    return ["restart"] if is_lifeline(unit) else list(ACTIONS)


def _valid_command(argv):
    """A command from the config is held to what can go into a sudo rule safely:
    an absolute path to a root-owned file nobody else can write, plain words."""
    if not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
        return False
    if not argv[0].startswith("/") or not all(SAFE_ARG_RE.fullmatch(a) for a in argv):
        return False
    try:
        st = os.stat(argv[0])
    except OSError:
        return False
    return st.st_uid == 0 and not (st.st_mode & 0o022)


def check_control_specs(cfg):
    """{check key: control spec}, from each check's own `control` and a
    dashboard check's `controls` map (agent 1.x called that map `games`)."""
    specs = {}
    for ch in check_specs(cfg):
        if ch["kind"] == "dashboard":
            for k, v in (ch.get("controls") or {}).items():
                if KEY_RE.fullmatch(str(k)) and isinstance(v, dict):
                    specs[str(k)] = v
        elif isinstance(ch.get("control"), dict):
            specs[ch["key"]] = ch["control"]
    return specs


def check_control(cfg, key):
    """(verbs, container, hints) a check may be controlled with; verbs empty without control."""
    spec = check_control_specs(cfg).get(key)
    if not isinstance(spec, dict):
        return [], None, {}
    container = spec.get("container") if isinstance(spec.get("container"), str) and CONTAINER_RE.fullmatch(spec["container"]) else None
    hints = {k: str(v)[:160] for k, v in (spec.get("hints") or {}).items() if k in CHECK_VERBS}
    if not cfg.get("allow_control"):
        return [], container, hints
    unit = spec.get("unit")
    if isinstance(unit, str) and UNIT_RE.fullmatch(unit) and unit in cfg["units"]:
        verbs = ["restart"] if is_lifeline(unit) else sorted(UNIT_CHECK_VERBS)
        return verbs, container, hints
    cmds = spec.get("commands")
    if isinstance(cmds, dict):
        verbs = sorted(v for v, argv in cmds.items() if v in CHECK_VERBS and _valid_command(argv))
        return verbs, container, hints
    return [], container, hints


def protocol1_controls(cfg):
    """{key: [verbs]} for the protocol-1 app's Games tab."""
    out_ = {}
    for key in sorted(check_control_specs(cfg)):
        verbs, _c, _h = check_control(cfg, key)
        if verbs:
            out_[key] = verbs
    return out_


