def meminfo():
    m = {}
    with open(os.path.join(PROC, "meminfo")) as fh:
        for line in fh:
            k, _, v = line.partition(":")
            try:
                m[k] = int(v.split()[0])          # kB
            except (ValueError, IndexError):
                continue
    total = m.get("MemTotal", 0)
    avail = m.get("MemAvailable", 0)
    sw_total = m.get("SwapTotal", 0)
    return {
        "total_mb": total // 1024,
        "used_mb": (total - avail) // 1024,
        "available_mb": avail // 1024,
        "cached_mb": (m.get("Cached", 0) + m.get("Buffers", 0)) // 1024,
        "swap_total_mb": sw_total // 1024,
        "swap_used_mb": (sw_total - m.get("SwapFree", 0)) // 1024,
    }


def pressure(kind):
    """PSI — the honest 'is this box overloaded?' signal, unlike load average."""
    try:
        with open(os.path.join(PROC, "pressure", kind)) as fh:
            for line in fh:
                if line.startswith("some"):
                    return float(line.split("avg10=")[1].split()[0])
    except (OSError, ValueError, IndexError):
        pass
    return None


def disks():
    out_ = []
    seen = set()
    try:
        with open(os.path.join(PROC, "mounts")) as fh:
            mounts = fh.readlines()
    except OSError:
        return out_
    for line in mounts:
        parts = line.split()
        if len(parts) < 2:
            continue
        dev, mnt = parts[0], parts[1].replace("\\040", " ")
        if not dev.startswith("/dev/") or mnt in seen or dev.startswith("/dev/loop"):
            continue
        seen.add(mnt)
        try:
            st = os.statvfs(mnt)
        except OSError:
            continue
        total = st.f_blocks * st.f_frsize
        if total < 1_000_000_000:                 # skip /boot-sized partitions
            continue
        free = st.f_bavail * st.f_frsize
        out_.append({
            "mount": mnt,
            "device": dev,
            "total_gb": round(total / 1e9, 1),
            "used_gb": round((total - st.f_bfree * st.f_frsize) / 1e9, 1),
            "free_gb": round(free / 1e9, 1),
            "used_pct": round(100.0 * (total - free) / total, 1) if total else 0.0,
        })
    return out_


def default_iface():
    """The interface of the default route (lowest metric), or None."""
    best = None
    try:
        with open(os.path.join(PROC, "net/route")) as fh:
            for line in fh.readlines()[1:]:
                f = line.split()
                if len(f) >= 7 and f[1] == "00000000":
                    metric = int(f[6]) if f[6].isdigit() else 0
                    if best is None or metric < best[1]:
                        best = (f[0], metric)
    except OSError:
        pass
    return best[0] if best else None


def iface_names():
    try:
        names = sorted(os.listdir(os.path.join(SYS, "class/net")))
    except OSError:
        names = []
    # Loopback and the per-container veth churn are noise on a phone screen.
    return [n for n in names if n != "lo" and not n.startswith(("veth", "br-", "docker"))]


def host_block(rates=True):
    with open(os.path.join(PROC, "uptime")) as fh:
        uptime_s = int(float(fh.read().split()[0]))
    load1, load5, load15 = os.getloadavg()
    names = iface_names()
    block = {
        "hostname": socket.gethostname(),
        "uptime_s": uptime_s,
        "load": [round(load1, 2), round(load5, 2), round(load15, 2)],
        "ncpu": os.cpu_count() or 1,
        "psi_cpu": pressure("cpu"),
        "psi_io": pressure("io"),
        "psi_mem": pressure("memory"),
        "mem": meminfo(),
        "disks": disks(),
        "primary_iface": default_iface() or (names[0] if names else ""),
    }
    if rates:
        s = sample(names)
        block.update({"cpu_pct": s["cpu_pct"], "cores": s["cores"], "window_s": s["window_s"],
                      "net": s["net"], "top": s["top"]})
    return block


