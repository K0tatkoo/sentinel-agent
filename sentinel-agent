def out(obj, code=0):
    json.dump(obj, sys.stdout, separators=(",", ":"), default=str)
    sys.stdout.write("\n")
    sys.stdout.flush()
    sys.exit(code)


def fail(msg, **extra):
    out({"ok": False, "error": str(msg), **extra})


def _read_conf_file(path):
    try:
        with open(path, "r") as fh:
            data = json.load(fh)
        return (data if isinstance(data, dict) else {}), None
    except FileNotFoundError:
        return {}, None
    except Exception as e:                                    # noqa: BLE001
        return {}, f"{path}: {e}"


def conf(path=None):
    """The config, laid over the defaults, with the protocol-1 keys understood."""
    raw, err = _read_conf_file(path or CONF_PATH)
    c = json.loads(json.dumps(DEFAULTS))            # a deep copy
    for k, v in raw.items():
        if isinstance(c.get(k), dict) and isinstance(v, dict) and k in ("paths", "hardware", "control"):
            c[k].update(v)
        else:
            c[k] = v
    if err:
        c["_conf_error"] = err

    # Agent 1.x configs: one dashboard URL and a games map, and "allow_control"
    # covering every watched unit and container.
    checks = [ch for ch in (c.get("checks") or []) if isinstance(ch, dict)]
    if raw.get("status_url") and not any(ch.get("kind") == "dashboard" for ch in checks):
        checks.append({"key": "dashboard", "kind": "dashboard", "url": raw["status_url"],
                       "hardware": True, "controls": raw.get("games") or {}})
    c["checks"] = checks
    if "control" not in raw:
        c["control"] = {"units": list(c["units"]), "containers": list(c["containers"])}
    for k in ("units", "containers"):
        c[k] = [x for x in (c.get(k) or []) if isinstance(x, str)]
    return c


def path_of(cfg, tool):
    p = (cfg.get("paths") or {}).get(tool) or DEFAULTS["paths"].get(tool) or tool
    return str(p)


def run(args, timeout=10):
    """Run argv with no shell. Returns (rc, stdout, stderr); never raises."""
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except FileNotFoundError:
        return 127, "", f"{args[0]}: not found"
    except subprocess.TimeoutExpired:
        return 124, "", f"{args[0]}: timed out after {timeout}s"
    except Exception as e:                                    # noqa: BLE001
        return 1, "", str(e)


def sudo(cfg, tool, *args, timeout=10):
    """Run one of the tools the sudo rules name, as root, by its absolute path."""
    return run(["sudo", "-n", path_of(cfg, tool), *args], timeout=timeout)


def _sudo_refused(stderr):
    s = stderr or ""
    return "password is required" in s or "not allowed" in s or "sudo: not found" in s


def _last_line(*texts):
    for text in texts:
        lines = [ln.strip() for ln in (text or "").splitlines() if ln.strip()]
        if lines:
            return lines[-1][:300]
    return ""


def _read(path, default=None):
    try:
        with open(path, "r", errors="replace") as fh:
            return fh.read().strip()
    except OSError:
        return default


def _num(text, scale=1.0):
    try:
        return float(text) / scale
    except (TypeError, ValueError):
        return None


# --------------------------------------------------------------------------- #
# caches: one file per kind, each change under its own lock
# --------------------------------------------------------------------------- #
#
# Agent 1.x read one state file at the start of a call and wrote it back at the
# end, so a `snapshot` and a `checks` running at once (the phone multiplexes its
# channels) overwrote each other's caches. Each cache now has its own file, and
# a read-modify-write holds that file's lock only for the write.

def _cache_path(name):
    return os.path.join(STATE_DIR, name + ".json")


def cache_get(name):
    try:
        with open(_cache_path(name), "r") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except Exception:                                         # noqa: BLE001
        return {}


@contextlib.contextmanager
def _locked(name):
    lock = None
    try:
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        lock = open(_cache_path(name) + ".lock", "a")
        fcntl.flock(lock, fcntl.LOCK_EX)
    except OSError:
        lock = None          # a cache that cannot be locked is a slow agent, not a broken one
    try:
        yield
    finally:
        if lock:
            fcntl.flock(lock, fcntl.LOCK_UN)
            lock.close()


def cache_put(name, data):
    try:
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        tmp = f"{_cache_path(name)}.{os.getpid()}.tmp"
        with open(tmp, "w") as fh:
            json.dump(data, fh, separators=(",", ":"))
        os.chmod(tmp, 0o600)
        os.replace(tmp, _cache_path(name))                    # atomic
    except Exception:                                         # noqa: BLE001
        pass


def cache_merge(name, updates):
    """Lay `updates` over the cached dict, under the lock, and return the result."""
    with _locked(name):
        data = cache_get(name)
        data.update(updates)
        cache_put(name, data)
        return data


