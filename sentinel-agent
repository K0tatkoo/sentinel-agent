def parse_nvidia_smi(text):
    gpus = []
    for line in text.replace("\r", "").splitlines():
        f = [x.strip() for x in line.split(",")]
        if len(f) < 8:
            continue

        def n(x):
            return None if x.startswith("[") or x.upper() in ("N/A", "") else _num(x)
        gpus.append({
            "index": int(f[0]) if f[0].isdigit() else len(gpus),
            "name": f[1],
            "celsius": n(f[2]),
            "util_pct": n(f[3]),
            "mem_used_mb": n(f[4]),
            "mem_total_mb": n(f[5]),
            "watts": n(f[6]),
            "fan_pct": n(f[7]),
        })
    return gpus


def read_gpu(cfg, fresh=True):
    cached = cache_get("gpu")
    if cached and (not fresh or time.time() - cached.get("t", 0) < GPU_MAX_AGE):
        return cached.get("gpus", []), cached.get("error")
    rc, so, se = run([path_of(cfg, "nvidia-smi"), *GPU_ARGS], timeout=10)
    if rc != 0:
        gpus, err = [], (_last_line(se, so) or f"nvidia-smi exited {rc}")[:200]
    else:
        gpus, err = parse_nvidia_smi(so), None
    cache_put("gpu", {"t": time.time(), "gpus": gpus, "error": err})
    return gpus, err


# --------------------------------------------------------------------------- #
# hardware: everything together
# --------------------------------------------------------------------------- #

def _apply_thresholds(cfg, temps):
    over = {str(k).lower(): v for k, v in (cfg.get("thresholds") or {}).items() if isinstance(v, dict)}
    for t in temps:
        o = over.get(t["label"].lower())
        if o:
            if isinstance(o.get("warn"), (int, float)):
                t["warn"] = float(o["warn"])
            if isinstance(o.get("crit"), (int, float)):
                t["crit"] = float(o["crit"])
    return temps


def features(cfg):
    hw = cfg.get("hardware") or {}
    f = []
    if cfg.get("checks"):
        f.append("checks")
    if hw.get("sensors", True):
        f.append("sensors")
    if hw.get("ipmi"):
        f.append("ipmi")
    if smart_devices(cfg):
        f.append("smart")
    if hw.get("gpu"):
        f.append("gpu")
    return f


def hardware_block(cfg, mode="poll", bmc=None):
    """
    The `hardware` block (PROTOCOL.md). mode:
      poll   kernel sensors fresh, GPU fresh (10 s cache), one stale SMART drive,
             BMC from cache (snapshot refreshes it separately)
      brief  kernel sensors fresh, everything else from cache
      full   every source fresh, every stale SMART drive
    """
    hw = cfg.get("hardware") or {}
    sources, temps, fans = {}, [], []
    watts = None

    if hw.get("sensors", True):
        t, fns, err = kernel_sensors()
        temps += t
        fans += fns
        sources["sensors"] = err

    if hw.get("ipmi"):
        if bmc is None:
            if mode == "full":
                detail, t2, f2, err = read_bmc(cfg)
            else:
                detail, t2, f2 = cached_bmc(cfg)
                err = None
        else:
            detail, t2, f2, err = bmc
        temps += t2
        fans += f2
        watts = (detail or {}).get("watts")
        sources["ipmi"] = err

    drives = []
    if smart_devices(cfg):
        drives, err = read_smart(cfg, {"poll": "stalest", "brief": "none", "full": "all"}[mode])
        sources["smart"] = err

    gpus = []
    if hw.get("gpu"):
        gpus, err = read_gpu(cfg, fresh=(mode != "brief"))
        sources["gpu"] = err
        for g in gpus:
            if g.get("celsius") is not None:
                temps.append({"label": g["name"] if len(gpus) == 1 else f"GPU {g['index']}",
                              "group": "gpu", "celsius": g["celsius"], "warn": None, "crit": None,
                              "status": None, "source": "gpu"})
    kernel_drives = " ".join(t["label"] for t in temps if t["group"] == "drive" and t["source"] == "sensors")
    for d in drives:
        dev = os.path.basename(d["device"].split(" ")[0])
        if d.get("celsius") is not None and dev not in kernel_drives:
            temps.append({"label": d.get("model") or d["device"], "group": "drive", "celsius": float(d["celsius"]),
                          "warn": None, "crit": None, "status": None, "source": "smart"})

    return {
        "model": model(cfg),
        "sources": sources,
        "temps": _apply_thresholds(cfg, temps),
        "fans": fans,
        "watts": watts,
        "drives": drives,
        "gpus": gpus,
    }


