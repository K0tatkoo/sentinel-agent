# Services worth watching on any server, whatever systemd says about them.
KEEP_RE = re.compile(
    r"^(ssh|sshd|docker|containerd|podman|nginx|apache2|httpd|caddy|traefik|haproxy|lighttpd|"
    r"mysql|mysqld|mariadb|postgresql(@.+)?|mongod|redis(-server)?(@.+)?|valkey(-server)?|memcached|"
    r"php[0-9.]*-fpm|tailscaled|cloudflared|wg-quick@.+|openvpn(-server|-client)?(@.+)?|zerotier-one|"
    r"fail2ban|crowdsec|postfix(@.*)?|exim4|dovecot|named|bind9|unbound|pihole-FTL|adguardhome|"
    r"jellyfin|plexmediaserver|emby-server|minecraft.*|grafana-server|prometheus|influxdb|"
    r"gitea|forgejo|gitlab-runsvdir|nextcloud.*|home-assistant.*|mosquitto|nodered|"
    r"libvirtd|smbd|nmbd|nfs-server)\.service$", re.I)

# The operating system's own machinery: running everywhere, never what the
# person installing a monitor means by "my services".
DROP_RE = re.compile(
    r"^(systemd-.*|dbus(-broker)?|getty@.*|serial-getty@.*|autovt@.*|user@.*|user-runtime-dir@.*|"
    r"polkit|polkitd|accounts-daemon|rtkit-daemon|udisks2|upower|packagekit|fwupd|"
    r"ModemManager|NetworkManager.*|wpa_supplicant|iwd|bluetooth|avahi-daemon|cups.*|colord|"
    r"multipathd|irqbalance|rsyslog|syslog-ng|cron|crond|cronie|anacron|atd|auditd|apparmor|"
    r"snapd|snapd\..*|snap\..*|unattended-upgrades|packagekit-offline-update|apt-daily.*|"
    r"thermald|power-profiles-daemon|switcheroo-control|tuned|ksmtuned|irqbalance|mcelog|"
    r"chrony|chronyd|ntp|ntpd|ntpsec|haveged|rngd|smartd|smartmontools|lvm2-.*|mdmonitor|"
    r"blk-availability|iscsid|open-iscsi|rpcbind|gssproxy|nfs-.*client.*|lxcfs|lxd.*|"
    r"qemu-guest-agent|open-vm-tools|vmtoolsd|vgauth|hv-.*|hyperv-.*|spice-vdagentd|lima-guestagent|"
    r"orbstack.*|vboxadd.*|vboxservice|xe-linux-distribution|"
    r"cloud-init.*|cloud-config|cloud-final|google-.*|amazon-ssm-agent|walinuxagent|waagent|"
    r"droplet-agent|do-agent|oracle-cloud-agent|hetzner-.*|"
    r"gdm|gdm3|lightdm|sddm|display-manager|gnome-.*|kerneloops|whoopsie|apport|"
    r"plymouth.*|console-setup|keyboard-setup|setvtrgb|"
    r"triggerhappy|hciuart|rpi-.*|dphys-swapfile|raspi-config|rpi-eeprom-update|"
    r"networkd-dispatcher|ufw|nftables|firewalld|netplan-.*|ifup@.*|"
    r"sentinel-.*)\.service$", re.I)


def classify_units(show_text):
    """`systemctl show -p Id,Type,UnitFileState,FragmentPath` of the running
    services -> the ones to watch, in order."""
    keep = []
    for b in _show_blocks(show_text):
        uid = b.get("Id", "")
        if not uid.endswith(".service") or not UNIT_RE.fullmatch(uid):
            continue
        if KEEP_RE.fullmatch(uid):
            keep.append(uid)
            continue
        if DROP_RE.fullmatch(uid):
            continue
        typ = b.get("Type", "")
        state = b.get("UnitFileState", "")
        frag = b.get("FragmentPath", "")
        if typ == "oneshot":
            continue
        # An instance of a template (foo@bar) usually comes and goes on its own:
        # watching one would raise an alarm every time it leaves.
        if "@" in uid:
            continue
        admin_made = frag.startswith(("/etc/systemd/system/", "/usr/local/"))
        if admin_made or state in ("enabled", "enabled-runtime", "linked", "linked-runtime"):
            keep.append(uid)
    return keep


def postgres_clusters(units, all_units):
    """Debian's postgresql.service is a oneshot that is always 'active'; the
    clusters themselves are postgresql@<ver>-<name>."""
    if "postgresql.service" not in units:
        return units
    clusters = [u for u in all_units if re.fullmatch(r"postgresql@[0-9.]+-[A-Za-z0-9_]+\.service", u)]
    out_ = [u for u in units if u != "postgresql.service"]
    return out_ + [c for c in clusters if c not in out_] if clusters else units


def which(name, extra=("/usr/sbin", "/sbin", "/usr/local/sbin", "/snap/bin")):
    for d in os.environ.get("PATH", "").split(os.pathsep) + list(extra):
        p = os.path.join(d, name)
        if d and os.path.isfile(p) and os.access(p, os.X_OK):
            # /bin/systemctl -> /usr/bin/systemctl is the same program; snap's
            # /snap/bin/docker -> /usr/bin/snap is not, and must keep its name.
            real = os.path.realpath(p)
            return real if os.path.basename(real) == name else p
    return None


def parse_smart_scan(text):
    """`smartctl --scan-open` -> [{"dev": ..., "type": ...}] for drives it could open."""
    devs = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        body, _, comment = line.partition("#")
        if "failed" in comment.lower() or "open failed" in line.lower():
            continue
        f = body.split()
        if not f or not f[0].startswith("/dev/"):
            continue
        typ = f[f.index("-d") + 1] if "-d" in f and f.index("-d") + 1 < len(f) else None
        entry = {"dev": f[0], "type": typ}
        if SAFE_ARG_RE.fullmatch(entry["dev"]) and (typ is None or SAFE_ARG_RE.fullmatch(typ)):
            devs.append(entry)
    return devs


def detect_paths():
    paths = {}
    for tool in ("systemctl", "journalctl", "docker", "ipmitool", "smartctl", "nvidia-smi", "systemd-detect-virt"):
        p = which(tool)
        if p:
            paths[tool] = p
    return paths


def detect_hardware(paths, notes):
    temps, fans, _ = kernel_sensors()
    hardware = {"sensors": bool(temps or fans), "ipmi": False, "smart": [], "gpu": False}
    if paths.get("ipmitool") and any(os.path.exists(p) for p in ("/dev/ipmi0", "/dev/ipmi/0", "/dev/ipmidev/0")):
        rc, so, _ = run([paths["ipmitool"], "sdr", "elist"], timeout=30)
        hardware["ipmi"] = rc == 0 and bool(so.strip())
    if paths.get("smartctl"):
        rc, so, _ = run([paths["smartctl"], "--scan-open"], timeout=30)
        hardware["smart"] = parse_smart_scan(so)
    else:
        notes.append("smartmontools is not installed: install it and re-run with --detect for drive health")
    if paths.get("nvidia-smi"):
        rc, _so, _ = run([paths["nvidia-smi"], "-L"], timeout=10)
        hardware["gpu"] = rc == 0
    return hardware


def detect():
    """What this server has: services, containers, hardware, tool paths."""
    notes = []
    paths = detect_paths()
    systemctl = paths.get("systemctl", "systemctl")

    rc, so, _ = run([systemctl, "list-units", "--type=service", "--state=running", "--no-legend", "--plain"], timeout=20)
    running = [ln.split()[0] for ln in so.splitlines() if ln.strip()] if rc == 0 else []
    rc, so2, _ = run([systemctl, "list-units", "--type=service", "--state=failed", "--no-legend", "--plain"], timeout=20)
    failed = [ln.split()[0] for ln in so2.splitlines() if ln.strip()] if rc == 0 else []
    names = [u for u in dict.fromkeys(running + failed) if UNIT_RE.fullmatch(u)]
    units = []
    if names:
        rc, show, _ = run([systemctl, "show", "-p", "Id,Type,UnitFileState,FragmentPath", *names], timeout=30)
        units = classify_units(show) if rc == 0 else []
    rc, so3, _ = run([systemctl, "list-units", "--type=service", "--all", "--no-legend", "--plain"], timeout=20)
    all_units = [ln.split()[0] for ln in so3.splitlines() if ln.strip()] if rc == 0 else []
    units = postgres_clusters(units, all_units)

    containers_ = []
    if paths.get("docker"):
        rc, so, se = run([paths["docker"], "ps", "-a", "--format", "{{.Names}}\t{{.State}}"], timeout=20)
        if rc == 0:
            for line in so.splitlines():
                name, _, state = line.partition("\t")
                if not CONTAINER_RE.fullmatch(name):
                    continue
                if state == "running":
                    containers_.append(name)
                    continue
                rc2, pol, _ = run([paths["docker"], "inspect", "--format", "{{.HostConfig.RestartPolicy.Name}}", name], timeout=10)
                if rc2 == 0 and pol.strip() in ("always", "unless-stopped", "on-failure"):
                    containers_.append(name)
        else:
            notes.append(f"docker: {_last_line(se)}")

    hardware = detect_hardware(paths, notes)
    return {"units": units, "containers": containers_, "hardware": hardware, "paths": paths, "notes": notes}


def parse_check_arg(text):
    """--check forms: a URL, host:port, minecraft:host:port, a2s:host:port."""
    text = text.strip()
    if text.startswith(("http://", "https://")):
        host = urllib.parse.urlsplit(text).hostname or "site"
        return {"kind": "http", "url": text, "label": host}
    kind = "tcp"
    m = re.fullmatch(r"(minecraft|a2s):(.+)", text)
    if m:
        kind, text = m.group(1), m.group(2)
    host, _, port = text.rpartition(":")
    if not host or not port.isdigit():
        raise ValueError(f"--check {text!r}: use a URL, host:port, minecraft:host:port or a2s:host:port")
    return {"kind": kind, "host": host, "port": int(port)}


def write_config(path, detected, checks_add, allow_control, fresh):
    """
    Lay detection and flags over the config on disk; never removes anything.
    Tool paths are refreshed every time (the sudo rules name them); hardware is
    detected when the config has none (an agent 1.x config); services and
    containers only on a fresh install or with --detect.
    """
    raw, err = _read_conf_file(path)
    if err:
        raise ValueError(err)
    c = raw
    if not fresh and "control" not in c:
        # Agent 1.x let the app control every watched unit and container. Keep
        # exactly that on an upgrade (lifelines still only restart): taking
        # control away is the owner's decision, not an installer side effect.
        c["control"] = ({"units": list(c.get("units") or []), "containers": list(c.get("containers") or [])}
                        if c.get("allow_control") else {"units": [], "containers": []})
    c.setdefault("paths", {}).update(detect_paths())
    if not detected and "hardware" not in c:
        notes = []
        c["hardware"] = detect_hardware(c["paths"], notes)
    if detected:
        for k in ("units", "containers"):
            have = c.get(k) or []
            c[k] = have + [x for x in detected[k] if x not in have]
        hw = c.setdefault("hardware", {})
        for k, v in detected["hardware"].items():
            if k == "smart":
                have = hw.get("smart") or []
                ids = {(d.get("dev"), d.get("type")) for d in have if isinstance(d, dict)}
                hw["smart"] = have + [d for d in v if (d["dev"], d["type"]) not in ids]
            elif fresh or k not in hw:
                hw[k] = v
            elif v:
                hw[k] = v
        paths = c.setdefault("paths", {})
        paths.update(detected["paths"])
    for ch in checks_add:
        checks = c.setdefault("checks", [])
        if not any(all(ch.get(k) == x.get(k) for k in ("kind", "url", "host", "port")) for x in checks):
            checks.append(ch)
    if allow_control is not None:
        c["allow_control"] = allow_control
    c.setdefault("allow_control", False)
    c.setdefault("control", {"units": [], "containers": []})
    ctl = c["control"]
    if allow_control and not (ctl.get("units") or ctl.get("containers")):
        # Turning control on with nothing listed would do nothing: start from
        # what is watched. Lifelines stay restart-only whatever is listed here.
        ctl["units"] = list(c.get("units") or [])
        ctl["containers"] = list(c.get("containers") or [])
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(c, fh, indent=2)
        fh.write("\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
    return c


def admin(argv):
    """`sentinel-agent --<verb>`: what the installer asks of the agent, as root.
    Never reachable through the forced command, which runs with no arguments."""
    verb = argv[0]
    if verb == "--version":
        print(VERSION)
        return 0
    if verb == "--detect":
        print(json.dumps(detect(), indent=2))
        return 0
    if verb == "--sudoers":
        user = argv[argv.index("--user") + 1] if "--user" in argv else None
        cpath = argv[argv.index("--conf") + 1] if "--conf" in argv else CONF_PATH
        sys.stdout.write(sudoers_text(conf(cpath), user, quiet_logs=False if "--no-quiet" in argv else None))
        return 0
    if verb == "--write-config":
        cpath = argv[argv.index("--conf") + 1] if "--conf" in argv else CONF_PATH
        fresh = not os.path.exists(cpath)
        detected = detect() if (fresh or "--detect" in argv) else None
        checks_add = [parse_check_arg(argv[i + 1]) for i, a in enumerate(argv) if a == "--check" and i + 1 < len(argv)]
        allow = True if "--allow-control" in argv else (False if "--read-only" in argv else None)
        c = write_config(cpath, detected, checks_add, allow, fresh)
        summary = {"units": c.get("units", []), "containers": c.get("containers", []),
                   "hardware": c.get("hardware", {}), "checks": len(c.get("checks", [])),
                   "allow_control": c.get("allow_control"), "notes": (detected or {}).get("notes", [])}
        print(json.dumps(summary))
        return 0
    print(f"unknown option {verb}", file=sys.stderr)
    return 2


