def _varint(n):
    out_ = b""
    n &= 0xFFFFFFFF
    while True:
        b = n & 0x7F
        n >>= 7
        out_ += bytes([b | (0x80 if n else 0)])
        if not n:
            return out_


def _read_exact(sock, n):
    data = b""
    while len(data) < n:
        piece = sock.recv(n - len(data))
        if not piece:
            raise ConnectionError("connection closed early")
        data += piece
    return data


def _read_varint(sock):
    value, shift = 0, 0
    for _ in range(5):
        b = _read_exact(sock, 1)[0]
        value |= (b & 0x7F) << shift
        if not b & 0x80:
            return value
        shift += 7
    raise ValueError("varint too long")


def _mc_text(desc):
    if isinstance(desc, str):
        return re.sub(r"§.", "", desc)
    if isinstance(desc, dict):
        return _mc_text(desc.get("text", "")) + "".join(_mc_text(x) for x in desc.get("extra", []) or [])
    if isinstance(desc, list):
        return "".join(_mc_text(x) for x in desc)
    return ""


def probe_minecraft(host, port, timeout=CHECK_TIMEOUT):
    """The Java Edition server-list ping: handshake, status request, one JSON reply."""
    t0 = time.monotonic()
    with socket.create_connection((host, port), timeout=timeout) as s:
        s.settimeout(timeout)
        hb = host.encode("utf-8")[:255]
        hs = b"\x00" + _varint(767) + _varint(len(hb)) + hb + struct.pack(">H", port) + _varint(1)
        s.sendall(_varint(len(hs)) + hs + b"\x01\x00")
        _read_varint(s)                                   # packet length
        if _read_varint(s) != 0:
            raise ValueError("not a status reply")
        j = json.loads(_read_exact(s, _read_varint(s)).decode("utf-8", "replace"))
    ms = int((time.monotonic() - t0) * 1000)
    players = j.get("players") or {}
    return ms, {"online": players.get("online"), "max": players.get("max"),
                "version": (j.get("version") or {}).get("name"),
                "motd": _mc_text(j.get("description"))[:120] or None}


def _cstr(data, i):
    end = data.index(b"\x00", i)
    return data[i:end].decode("utf-8", "replace"), end + 1


def probe_a2s(host, port, timeout=CHECK_TIMEOUT):
    """Valve's A2S_INFO over UDP, with the challenge round newer servers ask for."""
    t0 = time.monotonic()
    req = b"\xFF\xFF\xFF\xFFTSource Engine Query\x00"
    infos = socket.getaddrinfo(host, port, socket.AF_INET, socket.SOCK_DGRAM)
    addr = infos[0][4]
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.settimeout(timeout)
        s.sendto(req, addr)
        data, _ = s.recvfrom(4096)
        if len(data) >= 9 and data[4] == 0x41:            # S2C_CHALLENGE
            s.sendto(req + data[5:9], addr)
            data, _ = s.recvfrom(4096)
    ms = int((time.monotonic() - t0) * 1000)
    if len(data) < 6 or data[4] != 0x49:
        raise ValueError("not an A2S_INFO reply")
    i = 6
    name, i = _cstr(data, i)
    map_, i = _cstr(data, i)
    _folder, i = _cstr(data, i)
    _game, i = _cstr(data, i)
    i += 2                                                # app id
    online, max_ = data[i], data[i + 1]
    i += 7                                                # players, max, bots, type, env, visibility, vac
    version = None
    try:
        version, i = _cstr(data, i)
    except ValueError:
        pass
    return ms, {"online": online, "max": max_, "map": map_ or None, "name": name or None, "version": version}


def probe_http(spec, timeout=CHECK_TIMEOUT):
    url = spec["url"]
    u = urllib.parse.urlsplit(url)
    https = u.scheme == "https"
    host = u.hostname or ""
    port = u.port or (443 if https else 80)
    path = (u.path or "/") + (f"?{u.query}" if u.query else "")
    t0 = time.monotonic()
    if https:
        ctx = ssl.create_default_context()
        if spec.get("insecure"):
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
        conn = http.client.HTTPSConnection(host, port, timeout=timeout, context=ctx)
    else:
        conn = http.client.HTTPConnection(host, port, timeout=timeout)
    try:
        conn.request("GET", path, headers={"User-Agent": f"sentinel-agent/{VERSION}", "Accept": "*/*"})
        cert_days = None
        if https and conn.sock is not None:
            cert = conn.sock.getpeercert()
            if cert and cert.get("notAfter"):
                cert_days = int((ssl.cert_time_to_seconds(cert["notAfter"]) - time.time()) // 86400)
        resp = conn.getresponse()
        body = resp.read(262144) if spec.get("contains") else b""
        code = resp.status
    finally:
        conn.close()
    ms = int((time.monotonic() - t0) * 1000)
    expect = spec.get("expect")
    if isinstance(expect, list) and expect:
        up = code in expect
    else:
        up = 200 <= code < 400
    error = None if up else f"HTTP {code}"
    if up and spec.get("contains") and str(spec["contains"]).encode() not in body:
        up, error = False, "the expected text is not on the page"
    if cert_days is not None and cert_days < 0:
        up, error = False, "the certificate has expired"
    return ms, {"code": code, "cert_days": cert_days}, up, error


def _describe(e):
    if isinstance(e, ssl.SSLCertVerificationError):
        return f"certificate: {e.verify_message or e}"
    if isinstance(e, socket.timeout) or "timed out" in str(e):
        return "timed out"
    if isinstance(e, ConnectionRefusedError):
        return "connection refused"
    if isinstance(e, socket.gaierror):
        return "name not found"
    return str(e)[:200] or type(e).__name__


def _split_target(spec):
    host = str(spec.get("host") or "127.0.0.1")
    port = spec.get("port")
    if not isinstance(port, int):
        raise ValueError("port must be a number")
    return host, port


def run_check(spec):
    """One probe -> a check result (without the controls, which come from config)."""
    kind = spec.get("kind")
    base = {"key": spec["key"], "kind": kind, "label": spec.get("label") or spec["key"],
            "up": False, "state": "down", "ms": None, "error": None, "hint": None, "detail": {},
            "checked": int(time.time())}
    try:
        if kind == "http":
            base["target"] = spec.get("url")
            ms, detail, up, error = probe_http(spec)
            base.update(ms=ms, detail=detail, up=up, error=error)
        elif kind == "tcp":
            host, port = _split_target(spec)
            base["target"] = f"{host}:{port}"
            t0 = time.monotonic()
            with socket.create_connection((host, port), timeout=CHECK_TIMEOUT):
                pass
            base.update(ms=int((time.monotonic() - t0) * 1000), up=True)
        elif kind == "minecraft":
            host, port = _split_target(spec)
            base["target"] = f"{host}:{port}"
            ms, detail = probe_minecraft(host, port)
            base.update(ms=ms, detail=detail, up=True)
        elif kind == "a2s":
            host, port = _split_target(spec)
            base["target"] = f"{host}:{port}"
            ms, detail = probe_a2s(host, port)
            base.update(ms=ms, detail=detail, up=True)
            if not spec.get("label") and detail.get("name"):
                base["label"] = detail["name"]
        else:
            base["error"] = f"unknown check kind {kind!r}"
    except Exception as e:                                    # noqa: BLE001
        base["error"] = _describe(e)
    base["state"] = "up" if base["up"] else "down"
    return base


def check_specs(cfg):
    """The configured checks, each with a unique key, invalid ones dropped."""
    seen, specs = set(), []
    for i, ch in enumerate(cfg.get("checks") or []):
        if not isinstance(ch, dict) or ch.get("kind") not in ("http", "tcp", "minecraft", "a2s", "dashboard"):
            continue
        key = str(ch.get("key") or "")
        if not KEY_RE.fullmatch(key):
            hint = ch.get("url") or ch.get("host") or ch.get("kind")
            key = re.sub(r"[^a-z0-9_-]+", "-", str(hint).lower().split("//")[-1]).strip("-")[:28] or f"check{i}"
        while key in seen:
            key = f"{key[:28]}-{i}"
        seen.add(key)
        if ch["kind"] == "http":
            if not isinstance(ch.get("url"), str) or not ch["url"].startswith(("http://", "https://")):
                continue
        specs.append(dict(ch, key=key))
    return specs


def dashboard(cfg):
    """The first dashboard check's snapshot, or (None, None) when there is none."""
    spec = next((ch for ch in check_specs(cfg) if ch["kind"] == "dashboard"), None)
    if not spec:
        return None, None, None
    try:
        with urllib.request.urlopen(spec["url"], timeout=4) as r:
            return spec, json.loads(r.read().decode("utf-8")), None
    except urllib.error.HTTPError as e:
        return spec, None, f"status service HTTP {e.code}"
    except Exception as e:                                    # noqa: BLE001
        return spec, None, f"status service unreachable: {e}"


def dashboard_checks(spec, snap):
    """A dashboard's games and sites, as checks."""
    out_ = []
    for g in (snap or {}).get("games", []) or []:
        if not isinstance(g, dict) or not KEY_RE.fullmatch(str(g.get("key") or "")):
            continue
        state = g.get("state") or ("up" if g.get("up") else "down")
        out_.append({
            "key": g["key"], "kind": "game", "label": g.get("label") or g["key"],
            "target": g.get("join"), "up": bool(g.get("up")), "state": state,
            "ms": g.get("latencyMs"), "error": g.get("error"), "hint": g.get("hint"),
            "detail": {k: g.get(k) for k in ("online", "max", "version", "map", "motd", "join") if g.get(k) is not None},
            "uptime": g.get("uptime"), "checked": int(time.time()), "source": spec["key"],
        })
    for s in (snap or {}).get("sites", []) or []:
        if not isinstance(s, dict) or not s.get("key"):
            continue
        key = re.sub(r"[^a-z0-9_-]+", "-", str(s["key"]).lower())[:32]
        out_.append({
            "key": key, "kind": "site", "label": s.get("label") or key, "target": s.get("url"),
            "up": bool(s.get("ok")), "state": "up" if s.get("ok") else "down",
            "ms": s.get("latencyMs"), "error": s.get("error"), "hint": None, "detail": {},
            "uptime": s.get("uptime"), "checked": int(time.time()), "source": spec["key"],
        })
    return out_


def all_checks(cfg, refresh=True, dash=None):
    """Every check: probes reused for checks_interval_s, refreshed concurrently."""
    specs = [s for s in check_specs(cfg) if s["kind"] != "dashboard"]
    cached = cache_get("checks")
    now = time.time()
    interval = max(10, int(cfg.get("checks_interval_s") or 60))
    stale = [s for s in specs if refresh and now - (cached.get(s["key"]) or {}).get("checked", 0) >= interval]
    if stale:
        with ThreadPoolExecutor(max_workers=min(8, len(stale))) as pool:
            fresh = list(pool.map(run_check, stale))
        cached = cache_merge("checks", {r["key"]: r for r in fresh})
    results = []
    for s in specs:
        r = cached.get(s["key"])
        if r is None:
            r = {"key": s["key"], "kind": s["kind"], "label": s.get("label") or s["key"], "up": False,
                 "state": "down", "ms": None, "error": "not checked yet", "hint": None, "detail": {},
                 "checked": 0}
        r = dict(r)
        if s.get("label"):
            r["label"] = s["label"]
        results.append(r)

    if dash is None:
        dash = dashboard(cfg)
    spec, snap, _err = dash
    if spec:
        results += dashboard_checks(spec, snap)

    specs = check_control_specs(cfg)
    for r in results:
        verbs, container, hints = check_control(cfg, r["key"])
        unit = (specs.get(r["key"]) or {}).get("unit")
        r["controls"] = verbs
        r["container"] = container
        r["unit"] = unit if isinstance(unit, str) and unit in cfg["units"] else None
        r["hints"] = hints
    return results


