def _base(cfg):
    return {"ok": True, "version": VERSION, "protocol": PROTOCOL, "time": int(time.time()),
            "control": bool(cfg.get("allow_control")), "controls": protocol1_controls(cfg),
            "control_units": control_units(cfg), "control_containers": control_containers(cfg)}


def cmd_ping(cfg, _args):
    r = _base(cfg)
    rows, _err = docker_ps(cfg) if cfg["containers"] else ({}, None)
    r.update({
        "hostname": socket.gethostname(),
        "units": list(cfg["units"]),
        "containers": list(cfg["containers"]),
        "features": features(cfg),
        "model": model(cfg),
        "unwatched": len([n for n in (rows or {}) if n not in set(cfg["containers"])]),
    })
    return r


def _p1_hw(cfg, dash_snap, bmc):
    """The protocol-1 `hw` summary: a dashboard's, else the BMC's, else none."""
    if dash_snap and isinstance(dash_snap.get("hw"), dict):
        return summarize_status_hw(dash_snap["hw"]), None, "status"
    if bmc and bmc[0]:
        return summarize_bmc(bmc[0]), None, "bmc"
    if bmc and bmc[3]:
        return None, bmc[3], None
    return None, None, None


def _snapshot(cfg, brief):
    spec, dash_snap, dash_err = dashboard(cfg)
    hw_cfg = cfg.get("hardware") or {}
    bmc = None
    if hw_cfg.get("ipmi"):
        if brief:
            d, t2, f2 = cached_bmc(cfg)
            bmc = (d, t2, f2, None)
        elif dash_snap and isinstance(dash_snap.get("hw"), dict) and spec.get("hardware"):
            # One BMC, one poller: the dashboard already reads it on its own timer.
            bmc = dashboard_bmc(dash_snap["hw"])
        else:
            bmc = read_bmc(cfg)
    hw1, hw1_err, hw1_src = _p1_hw(cfg, dash_snap if (spec or {}).get("hardware") else None, bmc)
    docker, unwatched = containers(cfg, cfg["containers"], stats=not brief)
    r = _base(cfg)
    r.update({
        "unwatched": unwatched,
        "host": host_block(rates=not brief),
        "hardware": hardware_block(cfg, "brief" if brief else "poll", bmc=bmc),
        "hw": hw1,
        "hw_error": hw1_err,
        "hw_source": hw1_src,
        "services": services(cfg, cfg["units"]),
        "docker": docker,
        "games": (dash_snap or {}).get("games", []),
        "sites": (dash_snap or {}).get("sites", []),
        "status_error": dash_err if spec else None,
    })
    if brief:
        r["checks"] = all_checks(cfg, refresh=True, dash=(spec, dash_snap, dash_err))
    return r


def cmd_snapshot(cfg, _args):
    return _snapshot(cfg, brief=False)


def cmd_brief(cfg, _args):
    return _snapshot(cfg, brief=True)


def cmd_checks(cfg, _args):
    return {"ok": True, "checks": all_checks(cfg, refresh=True)}


def cmd_hw(cfg, _args):
    hw_cfg = cfg.get("hardware") or {}
    bmc = read_bmc(cfg) if hw_cfg.get("ipmi") else None
    hardware = hardware_block(cfg, "full", bmc=bmc)
    return {"ok": True, "hw": bmc[0] if bmc else None, "age_s": 0,
            "error": bmc[3] if bmc else None, "hardware": hardware, "sel": bool(hw_cfg.get("ipmi"))}


def cmd_sel(cfg, args):
    if not (cfg.get("hardware") or {}).get("ipmi"):
        return {"ok": False, "events": [], "error": "this server has no BMC"}
    limit = 25
    if args:
        if not args[0].isdigit():
            return {"ok": False, "error": "sel: count must be a number"}
        limit = max(1, min(SEL_TAIL, int(args[0])))
    events, err = read_sel(cfg, limit)
    return {"ok": events is not None, "events": events or [], "error": err}


def journal_argv(cfg, unit):
    return [path_of(cfg, "journalctl"), "-u", unit, "-n", str(LOG_TAIL), "--no-pager", "-o", "short-iso"]


def cmd_logs(cfg, args):
    if not args:
        return {"ok": False, "error": "logs: unit required"}
    unit = args[0]
    lines = 120
    if len(args) > 1:
        if not args[1].isdigit():
            return {"ok": False, "error": "logs: line count must be a number"}
        lines = max(1, min(cfg["max_log_lines"], LOG_TAIL, int(args[1])))
    if not UNIT_RE.fullmatch(unit) or unit not in cfg["units"]:
        return {"ok": False, "error": f"logs: {unit!r} is not a watched unit"}
    argv = journal_argv(cfg, unit)
    # Through sudo, so an account outside the journal groups can still read the
    # watched units; an account inside them (agent 1.x installs) needs no rule.
    rc, so, se = run(["sudo", "-n", *argv], timeout=20)
    if rc != 0 and _sudo_refused(se):
        rc, so, se = run(argv, timeout=20)
    if rc != 0:
        return {"ok": False, "error": (se.strip() or f"journalctl exited {rc}")[:300]}
    return {"ok": True, "unit": unit, "lines": so.splitlines()[-lines:]}


def cmd_dlogs(cfg, args):
    if not args:
        return {"ok": False, "error": "dlogs: container required"}
    name = args[0]
    lines = 120
    if len(args) > 1:
        if not args[1].isdigit():
            return {"ok": False, "error": "dlogs: line count must be a number"}
        lines = max(1, min(cfg["max_log_lines"], LOG_TAIL, int(args[1])))
    if not CONTAINER_RE.fullmatch(name) or name not in cfg["containers"]:
        return {"ok": False, "error": f"dlogs: {name!r} is not a watched container"}
    rc, so, se = sudo(cfg, "docker", "logs", "--tail", str(LOG_TAIL), "--timestamps", name, timeout=25)
    if rc != 0:
        return {"ok": False, "error": (se.strip() or f"docker exited {rc}")[:300]}
    return {"ok": True, "container": name, "lines": (so + se).splitlines()[-lines:]}


def cmd_action(cfg, args):
    if not cfg.get("allow_control"):
        return {"ok": False, "error": "control is disabled on this agent"}
    if len(args) < 2:
        return {"ok": False, "error": "action: <start|stop|restart> <unit>"}
    verb, unit = args[0], args[1]
    if verb not in ACTIONS:
        return {"ok": False, "error": f"action: {verb!r} is not one of {'/'.join(ACTIONS)}"}
    if not UNIT_RE.fullmatch(unit) or unit not in control_units(cfg):
        return {"ok": False, "error": f"action: {unit!r} is not a controllable unit"}
    if verb not in unit_verbs(unit):
        return {"ok": False, "error": f"{unit} can only be restarted from the app: stopping it could cut off the way back in"}
    rc, _so, se = sudo(cfg, "systemctl", verb, unit, timeout=90)
    if rc != 0:
        return {"ok": False, "error": (se.strip() or f"systemctl exited {rc}")[:300]}
    time.sleep(1.0)                      # let the state settle before reporting it back
    return {"ok": True, "unit": unit, "verb": verb, "state": services(cfg, [unit])}


def cmd_daction(cfg, args):
    if not cfg.get("allow_control"):
        return {"ok": False, "error": "control is disabled on this agent"}
    if len(args) < 2:
        return {"ok": False, "error": "daction: <start|stop|restart> <container>"}
    verb, name = args[0], args[1]
    if verb not in ACTIONS:
        return {"ok": False, "error": f"daction: {verb!r} is not one of {'/'.join(ACTIONS)}"}
    if CONTAINER_RE.fullmatch(name) and name in check_container_names(cfg):
        return {"ok": False, "error": f"{name} is run by one of the checks: use its controls instead"}
    if not CONTAINER_RE.fullmatch(name) or name not in control_containers(cfg):
        return {"ok": False, "error": f"daction: {name!r} is not a controllable container"}
    rc, _so, se = sudo(cfg, "docker", verb, name, timeout=120)
    if rc != 0:
        return {"ok": False, "error": (se.strip() or f"docker exited {rc}")[:300]}
    return {"ok": True, "container": name, "verb": verb}


def cmd_check(cfg, args):
    if not cfg.get("allow_control"):
        return {"ok": False, "error": "control is disabled on this agent"}
    if len(args) < 2:
        return {"ok": False, "error": "check: <verb> <key>"}
    verb, key = args[0], args[1]
    if not KEY_RE.fullmatch(key or ""):
        return {"ok": False, "error": f"check: {key!r} is not a check"}
    verbs, _container, _hints = check_control(cfg, key)
    if verb not in verbs:
        return {"ok": False, "error": f"check: {key} cannot {verb!r}"}
    spec = check_control_specs(cfg)[key]
    unit = spec.get("unit")
    if isinstance(unit, str):
        rc, so, se = sudo(cfg, "systemctl", *UNIT_CHECK_VERBS[verb], unit, timeout=120)
        if rc != 0:
            if _sudo_refused(se):
                return {"ok": False, "error": "sudo refused it: re-run the Sentinel installer on the server"}
            return {"ok": False, "error": _last_line(se, so) or f"systemctl exited {rc}"}
        time.sleep(1.0)
        return {"ok": True, "game": key, "check": key, "verb": verb, "state": services(cfg, [unit])}
    argv = spec["commands"][verb]
    # A save, a clean stop and a restart can take minutes (a game server that
    # saves first), so the wait is long; the app waits a little longer still.
    rc, so, se = run(["sudo", "-n", *argv], timeout=480)
    said = _last_line(so, se)
    if rc != 0:
        if _sudo_refused(se):
            return {"ok": False, "error": f"sudo refused {os.path.basename(argv[0])}: re-run the Sentinel installer"}
        return {"ok": False, "error": said or f"{os.path.basename(argv[0])} exited {rc}"}
    return {"ok": True, "game": key, "check": key, "verb": verb, "detail": said}


COMMANDS = {
    "ping": cmd_ping,
    "snapshot": cmd_snapshot,
    "brief": cmd_brief,
    "checks": cmd_checks,
    "hw": cmd_hw,
    "sel": cmd_sel,
    "logs": cmd_logs,
    "dlogs": cmd_dlogs,
    "action": cmd_action,
    "daction": cmd_daction,
    "check": cmd_check,
    "game": cmd_check,              # protocol 1's name
}


