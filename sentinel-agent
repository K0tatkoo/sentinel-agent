SHOW_PROPS = ("Id", "Description", "ActiveState", "SubState", "UnitFileState",
              "ExecMainStartTimestamp", "NRestarts", "MemoryCurrent", "MainPID",
              "Result", "LoadState")


def _show_blocks(text):
    blocks, cur = [], {}
    for line in text.splitlines():
        if not line.strip():
            if cur:
                blocks.append(cur)
                cur = {}
            continue
        k, _, v = line.partition("=")
        cur[k] = v
    if cur:
        blocks.append(cur)
    return blocks


def services(cfg, units):
    """One `systemctl show` for every unit — N forks here would be N × latency."""
    if not units:
        return []
    rc, so, se = run([path_of(cfg, "systemctl"), "show", "--no-pager",
                      *[f"--property={p}" for p in SHOW_PROPS], *units], timeout=15)
    if rc != 0 and not so:
        return [{"unit": u, "error": se.strip() or f"systemctl exited {rc}"} for u in units]
    result = []
    for b in _show_blocks(so):
        mem = b.get("MemoryCurrent", "")
        started = b.get("ExecMainStartTimestamp", "").strip()
        result.append({
            "unit": b.get("Id", "?"),
            "description": b.get("Description", ""),
            "active": b.get("ActiveState", "unknown"),
            "sub": b.get("SubState", "unknown"),
            "enabled": b.get("UnitFileState", ""),
            "loaded": b.get("LoadState", ""),
            "restarts": int(b["NRestarts"]) if b.get("NRestarts", "").isdigit() else 0,
            # systemd reports [not set] / infinity for units with no cgroup accounting.
            "mem_mb": round(int(mem) / 1048576, 1) if mem.isdigit() else None,
            "pid": int(b["MainPID"]) if b.get("MainPID", "").isdigit() and b["MainPID"] != "0" else None,
            "since": started or None,
            "result": b.get("Result", ""),
        })
    return result


def docker_ps(cfg):
    """Every container (name -> ps row), or (None, error)."""
    rc, so, se = sudo(cfg, "docker", *DOCKER_PS, timeout=15)
    if rc != 0:
        return None, (se.strip() or f"docker exited {rc}")[:200]
    rows = {}
    for line in so.splitlines():
        try:
            c = json.loads(line)
        except json.JSONDecodeError:
            continue
        rows[c.get("Names", "")] = c
    return rows, None


def containers(cfg, names, stats=True):
    """The watched containers, plus how many others exist."""
    if not names:
        return {"error": None, "list": []}, 0
    rows, err = docker_ps(cfg)
    if rows is None:
        return {"error": err, "list": []}, 0
    found = []
    for name in names:
        c = rows.get(name)
        if c is None:
            found.append({"name": name, "image": "", "state": "missing",
                          "status": "no container of this name", "health": None, "running_for": ""})
            continue
        status = c.get("Status", "")
        health = None
        if "(healthy)" in status:
            health = "healthy"
        elif "(unhealthy)" in status:
            health = "unhealthy"
        elif "(health: starting)" in status:
            health = "starting"
        found.append({
            "name": name,
            "image": c.get("Image", ""),
            "state": c.get("State", ""),
            "status": status,
            "health": health,
            "running_for": c.get("RunningFor", ""),
        })
    unwatched = len([n for n in rows if n not in set(names)])

    # `docker stats` blocks for a sampling window, so only pay for it when
    # something is actually running.
    if stats and any(c["state"] == "running" for c in found):
        rc, so, _ = sudo(cfg, "docker", *DOCKER_STATS, timeout=20)
        if rc == 0:
            st_by_name = {}
            for line in so.splitlines():
                try:
                    st = json.loads(line)
                except json.JSONDecodeError:
                    continue
                st_by_name[st.get("Name", "")] = st
            for c in found:
                st = st_by_name.get(c["name"])
                if st:
                    c["cpu_pct"] = _pct(st.get("CPUPerc", ""))
                    c["mem"] = st.get("MemUsage", "")
                    c["mem_pct"] = _pct(st.get("MemPerc", ""))
    return {"error": None, "list": found}, unwatched


def _pct(text):
    try:
        return round(float(str(text).strip().rstrip("%")), 1)
    except ValueError:
        return None


# --------------------------------------------------------------------------- #
# hardware: the model
# --------------------------------------------------------------------------- #

_JUNK_DMI = re.compile(r"^(to be filled|system product name|system manufacturer|default string|"
                       r"not applicable|not specified|o\.e\.m\.|none|$)", re.I)


def model(cfg):
    cached = cache_get("model")
    if cached.get("v") == 1:
        return cached["model"]
    dmi = os.path.join(SYS, "class/dmi/id")
    vendor = _read(os.path.join(dmi, "sys_vendor")) or ""
    name = _read(os.path.join(dmi, "product_name")) or ""
    if _JUNK_DMI.match(name):
        name = _read(os.path.join(dmi, "board_name")) or ""
        vendor = _read(os.path.join(dmi, "board_vendor")) or vendor
    if _JUNK_DMI.match(name):
        name = ""
    if _JUNK_DMI.match(vendor):
        vendor = ""
    tree = _read(os.path.join(PROC, "device-tree/model"))
    if tree and not name:                          # a Raspberry Pi, or another board
        name = tree.replace("\x00", "").strip()
    rc, so, _ = run([path_of(cfg, "systemd-detect-virt")], timeout=5)
    virt = so.strip() if rc == 0 and so.strip() and so.strip() != "none" else None
    result = {"vendor": vendor or None, "name": name or None, "virt": virt}
    cache_put("model", {"v": 1, "model": result})
    return result


# --------------------------------------------------------------------------- #
# hardware: kernel sensors
# --------------------------------------------------------------------------- #

def _hwmon_group(chip):
    n = chip.lower()
    if n in ("coretemp", "k10temp", "k8temp", "zenpower", "cpu_thermal", "soc_thermal", "cpu-thermal",
             "x86_pkg_temp", "fam15h_power") or n.startswith(("cpu", "soc")):
        return "cpu"
    if n in ("nvme", "drivetemp") or n.startswith("nvme"):
        return "drive"
    if n in ("amdgpu", "radeon", "nouveau", "i915", "xe"):
        return "gpu"
    if n.startswith(("acpitz", "pch_", "nct", "it8", "w83", "f71", "asus", "dell_smm", "thinkpad",
                     "spd5118", "jc42", "gigabyte", "aquacomputer")):
        return "board"
    return "other"


def _attr_dir(chip_dir):
    """Modern kernels keep the attributes next to `name`; older ones under device/."""
    if os.path.exists(os.path.join(chip_dir, "name")):
        return chip_dir
    if os.path.exists(os.path.join(chip_dir, "device", "name")):
        return os.path.join(chip_dir, "device")
    return chip_dir


def _sane_c(v):
    return v is not None and -40.0 < v < 150.0


def _chip_label(chip_dir, chip, group):
    """What sets one chip apart from another of the same kind: an NVMe or disk's name."""
    if group != "drive":
        return None
    link = os.path.realpath(os.path.join(chip_dir, "device"))
    base = os.path.basename(link)
    if base.startswith("nvme"):
        return base
    model_ = _read(os.path.join(chip_dir, "device", "model"))
    return model_ or None


def _natural(s):
    return [int(t) if t.isdigit() else t for t in re.split(r"(\d+)", s)]


def read_hwmon():
    """Temperatures and fans from /sys/class/hwmon, with the kernel's own thresholds."""
    base = os.path.join(SYS, "class/hwmon")
    try:
        chips = sorted(os.listdir(base), key=_natural)
    except OSError:
        return [], [], None
    names = {}
    for chip in chips:
        names.setdefault(_read(os.path.join(_attr_dir(os.path.join(base, chip)), "name")) or chip, []).append(chip)

    temps, fans = [], []
    for chip in chips:
        chip_dir = os.path.join(base, chip)
        attrs = _attr_dir(chip_dir)
        name = _read(os.path.join(attrs, "name")) or chip
        group = _hwmon_group(name)
        siblings = names.get(name, [chip])
        prefix = None
        own = _chip_label(chip_dir, name, group)
        if own:
            prefix = own
        elif len(siblings) > 1:
            prefix = f"CPU {siblings.index(chip) + 1}" if group == "cpu" else f"{name} {siblings.index(chip) + 1}"
        try:
            files = os.listdir(attrs)
        except OSError:
            continue
        for f in sorted(files, key=_natural):
            m = re.fullmatch(r"temp(\d+)_input", f)
            if m:
                n = m.group(1)
                c = _num(_read(os.path.join(attrs, f)), 1000.0)
                if not _sane_c(c):
                    continue
                label = _read(os.path.join(attrs, f"temp{n}_label")) or f"{name} {n}"
                warn = _num(_read(os.path.join(attrs, f"temp{n}_max")), 1000.0)
                crit = _num(_read(os.path.join(attrs, f"temp{n}_crit")), 1000.0)
                temps.append({
                    "label": f"{prefix} · {label}" if prefix else label,
                    "group": group,
                    "celsius": round(c, 1),
                    "warn": round(warn, 1) if _sane_c(warn) and warn > 0 else None,
                    "crit": round(crit, 1) if _sane_c(crit) and crit > 0 else None,
                    "status": None,
                    "source": "sensors",
                })
                continue
            m = re.fullmatch(r"fan(\d+)_input", f)
            if m:
                n = m.group(1)
                rpm = _num(_read(os.path.join(attrs, f)))
                # Super-I/O chips report 0 for every header with nothing on it,
                # which would read as a dead fan. A BMC tells the two apart; the
                # kernel's sensors cannot, so a 0 here is left out.
                if rpm is None or rpm <= 0:
                    continue
                label = _read(os.path.join(attrs, f"fan{n}_label")) or f"Fan {n}"
                fans.append({"label": f"{prefix} · {label}" if prefix else label,
                             "rpm": round(rpm), "status": None, "source": "sensors"})
    return temps, fans, None


def read_thermal_zones():
    """The fallback for boards whose sensors are thermal zones only (a Raspberry Pi)."""
    base = os.path.join(SYS, "class/thermal")
    temps = []
    try:
        zones = sorted((z for z in os.listdir(base) if z.startswith("thermal_zone")), key=_natural)
    except OSError:
        return temps
    for z in zones:
        d = os.path.join(base, z)
        kind = _read(os.path.join(d, "type")) or z
        c = _num(_read(os.path.join(d, "temp")), 1000.0)
        if not _sane_c(c):
            continue
        warn = crit = None
        for i in range(12):
            t = _num(_read(os.path.join(d, f"trip_point_{i}_temp")), 1000.0)
            typ = _read(os.path.join(d, f"trip_point_{i}_type"))
            if t is None or typ is None:
                break
            if not _sane_c(t) or t <= 0:
                continue
            if typ in ("passive", "hot") and (warn is None or t < warn):
                warn = t
            elif typ == "critical":
                crit = t
        temps.append({"label": kind, "group": _hwmon_group(kind), "celsius": round(c, 1),
                      "warn": warn, "crit": crit, "status": None, "source": "sensors"})
    return temps


def kernel_sensors():
    temps, fans, err = read_hwmon()
    if not temps:
        temps = read_thermal_zones()
    return temps, fans, err


# --------------------------------------------------------------------------- #
# hardware: a BMC, any vendor
# --------------------------------------------------------------------------- #

def _reading(text):
    """
    Split '4680 RPM' into (4680.0, 'RPM').

    'Not Readable' and 'No Reading' come back as None, never 0 — a fan at 0 RPM
    is an emergency, a fan the BMC declines to report is a quirk.
    """
    text = text.strip()
    if not text or text.lower().startswith(("not readable", "no reading", "disabled")):
        return None, ""
    m = re.match(r"^(-?\d+(?:\.\d+)?)\s*(.*)$", text)
    if not m:
        return None, text
    return float(m.group(1)), m.group(2).strip()


# The status column of `ipmitool sdr elist`: what the BMC itself makes of the
# reading against its own thresholds. nc = non-critical, cr = critical,
# nr = non-recoverable. This is how every vendor's thresholds reach the app
# without anybody typing them in.
_SDR_STATUS = {"ok": "ok", "nc": "warn", "cr": "crit", "nr": "crit"}

_FAN_RE = re.compile(r"(?i)^(?:sys(?:tem)?[\s_]*)?fan[\s_]*(\d+)[\s_]*([ab])?(?:[\s_]*rpm)?$")
_WATTS_RE = re.compile(r"(?i)(pwr|power)[\s_]*(consumption|meter)|system[\s_]*(level|power)|total[\s_]*power|^power$")


def parse_sdr(text):
    """
    `ipmitool sdr elist` -> (the protocol-1 detail, hardware temps, hardware fans).

    Classified by the unit of each reading and the entity ID it belongs to, not
    by one vendor's sensor names: degrees C is a temperature, RPM a fan, Watts
    power; entity 3 / 65 is a processor and entity 10 a power supply. Dell's
    names (Inlet Temp, Fan1A, Pwr Consumption) are what the R620 these rules
    were first written against calls them, and they still come out the same.
    """
    temps1, temps2, fans2 = [], [], []
    fans1, psus = {}, {}
    watts = None
    fan_redundancy = ps_redundancy = None
    auto_fan = 100

    for line in text.splitlines():
        f = [c.strip() for c in line.split("|")]
        if len(f) < 5:
            continue
        name, _sid, state, entity, raw = f[0], f[1], f[2], f[3], f[4]
        value, unit = _reading(raw)
        status = _SDR_STATUS.get(state)
        ent = entity.split(".")[0] if "." in entity else entity
        inst = entity.split(".")[1] if "." in entity else "1"
        lname = name.lower()

        if unit.lower().startswith("degrees c"):
            if "inlet" in lname or "ambient" in lname or "intake" in lname:
                label, kind = "Inlet", "inlet"
            elif "exhaust" in lname or "outlet" in lname:
                label, kind = "Exhaust", "exhaust"
            elif ent in ("3", "65"):
                label = f"CPU {inst}" if lname in ("temp", "cpu temp") else f"CPU {inst} {name}"
                kind = "cpu"
            else:
                label, kind = re.sub(r"(?i)\s*temp$", "", name) or name, "board"
            temps1.append({"label": label, "kind": kind, "celsius": value, "state": state})
            temps2.append({"label": label, "group": kind, "celsius": value, "warn": None, "crit": None,
                           "status": status, "source": "ipmi"})

        elif unit.upper() == "RPM":
            m = _FAN_RE.fullmatch(name)
            if m:
                idx, side = int(m.group(1)), (m.group(2) or "a").lower()
            else:
                auto_fan += 1
                idx, side = auto_fan, "a"
            fans1.setdefault(idx, {"module": idx, "a_rpm": None, "b_rpm": None, "state": state})
            fans1[idx]["a_rpm" if side == "a" else "b_rpm"] = value
            label = f"Fan {idx}{side.upper()}" if m and m.group(2) else (f"Fan {idx}" if m else name)
            fans2.append({"label": label, "rpm": value, "status": status, "source": "ipmi"})

        elif "redundancy" in lname and "fan" in lname:
            fan_redundancy = raw
        elif "redundancy" in lname and ("ps" in lname or "power" in lname):
            ps_redundancy = raw

        elif ent == "10":
            bay = int(inst) if inst.isdigit() else len(psus) + 1
            p = psus.setdefault(bay, {"bay": bay})
            if unit == "Amps":
                p["amps"] = value
            elif unit == "Volts":
                p["volts"] = value
            elif unit == "Watts":
                p["input_watts"] = value
            elif value is None and raw:
                low = raw.lower()
                if lname.startswith("status") or "presence" not in lname:
                    p["status"] = raw
                    p["fault"] = any(w in low for w in ("fail", "fault", "lost", "predictive"))

        elif unit == "Watts" and watts is None and _WATTS_RE.search(name):
            watts = value

    bays = sorted(psus.values(), key=lambda p: p["bay"])
    if watts is None:
        direct = [p.get("input_watts") for p in bays if p.get("input_watts") is not None]
        watts = sum(direct) if direct else None
    # A BMC that cannot meter each supply (Dell quantises bay current to 0.2 A)
    # gets the accurate chassis total split in proportion to the bay currents,
    # rather than an invented 50/50.
    amps_total = sum(p.get("amps") or 0.0 for p in bays if not p.get("fault"))
    for p in bays:
        p.setdefault("fault", False)
        if p.get("input_watts") is not None:
            p["watts"] = p.pop("input_watts")
        elif watts is None or amps_total <= 0 or p.get("fault"):
            p["watts"] = None
        else:
            p["watts"] = round(watts * (p.get("amps") or 0.0) / amps_total)

    detail = {
        "temps": temps1,
        "fans": sorted(fans1.values(), key=lambda x: x["module"]),
        "psus": bays,
        "watts": watts,
        "fan_redundancy": fan_redundancy,
        "ps_redundancy": ps_redundancy,
    }
    return detail, temps2, fans2


def read_bmc(cfg):
    """(detail, temps2, fans2, error), cached for hw_cache_s: one sdr read is ~1.8 s."""
    cached = cache_get("bmc")
    if cached and time.time() - cached.get("t", 0) < cfg["hw_cache_s"]:
        return cached["detail"], cached["temps"], cached["fans"], None
    rc, so, se = sudo(cfg, "ipmitool", "sdr", "elist", timeout=25)
    if rc != 0:
        return None, [], [], (se.strip() or f"ipmitool exited {rc}")[:200]
    detail, temps2, fans2 = parse_sdr(so)
    cache_put("bmc", {"t": time.time(), "detail": detail, "temps": temps2, "fans": fans2})
    return detail, temps2, fans2, None


def cached_bmc(cfg):
    cached = cache_get("bmc")
    if cached and time.time() - cached.get("t", 0) < 10 * 60:
        return cached["detail"], cached["temps"], cached["fans"]
    return None, [], []


def summarize_bmc(full):
    """Collapse the detailed BMC read into the protocol-1 summary `snapshot` returns."""
    temps = full.get("temps", [])

    def one(kind):
        return next((t["celsius"] for t in temps if t["kind"] == kind), None)

    cpu = [t["celsius"] for t in temps if t["kind"] == "cpu" and t["celsius"] is not None]
    rpms = [r for f in full.get("fans", []) for r in (f["a_rpm"], f["b_rpm"]) if r is not None]
    return {
        "inlet_c": one("inlet"),
        "exhaust_c": one("exhaust"),
        "cpu_max_c": max(cpu) if cpu else None,
        "fan_modules": len(full.get("fans", [])),
        "fan_avg_rpm": round(sum(rpms) / len(rpms)) if rpms else None,
        "watts": full.get("watts"),
        "redundancy": full.get("fan_redundancy"),
        "psus": [
            {"bay": p.get("bay"), "volts": p.get("volts"), "amps": p.get("amps"),
             "watts": p.get("watts"), "fault": bool(p.get("fault"))}
            for p in full.get("psus", [])
        ],
    }


def summarize_status_hw(hw):
    """The same summary, from a status dashboard's own field names."""
    return {
        "inlet_c": hw.get("inlet_c"),
        "exhaust_c": hw.get("exhaust_c"),
        "cpu_max_c": hw.get("cpu_max_c"),
        "fan_modules": hw.get("fan_modules"),
        "fan_avg_rpm": hw.get("fan_avg_rpm"),
        "watts": hw.get("watts"),
        "redundancy": hw.get("redundancy"),
        "psus": [
            {"bay": p.get("index"), "volts": p.get("volts"), "amps": p.get("amps"),
             "watts": p.get("watts"), "fault": bool(p.get("fault"))}
            for p in hw.get("psus", [])
        ],
    }


def dashboard_bmc(hw):
    """A dashboard's hardware summary as a BMC read: (detail, temps, fans, error).
    The dashboard already polls the BMC on its own timer; reading it a second
    time from here would double the slowest call on the machine."""
    temps = []
    for key, label, group in (("inlet_c", "Inlet", "inlet"), ("exhaust_c", "Exhaust", "exhaust"),
                              ("cpu_max_c", "CPU (hottest)", "cpu")):
        v = hw.get(key)
        if isinstance(v, (int, float)):
            temps.append({"label": label, "group": group, "celsius": float(v), "warn": None, "crit": None,
                          "status": None, "source": "ipmi"})
    fans = []
    if isinstance(hw.get("fan_avg_rpm"), (int, float)):
        fans.append({"label": "Fans (average)", "rpm": float(hw["fan_avg_rpm"]), "status": None, "source": "ipmi"})
    return {"watts": hw.get("watts")}, temps, fans, None


def read_sel(cfg, limit):
    rc, so, se = sudo(cfg, "ipmitool", "sel", "elist", "last", str(SEL_TAIL), timeout=30)
    if rc != 0:
        return None, (se.strip() or f"ipmitool exited {rc}")[:200]
    events = []
    for line in so.splitlines():
        f = [c.strip() for c in line.split("|")]
        if len(f) < 5:
            continue
        events.append({
            "id": f[0], "date": f[1], "time": f[2], "sensor": f[3], "event": f[4],
            "direction": f[5] if len(f) > 5 else "",
            "detail": f[6] if len(f) > 6 else "",
        })
    events.reverse()                      # newest first, which is what a phone wants
    return events[:limit], None


# --------------------------------------------------------------------------- #
# hardware: SMART
# --------------------------------------------------------------------------- #

def smart_devices(cfg):
    out_ = []
    for d in (cfg.get("hardware") or {}).get("smart") or []:
        if not isinstance(d, dict):
            continue
        dev, typ = str(d.get("dev") or ""), d.get("type")
        if not dev.startswith("/dev/") or not SAFE_ARG_RE.fullmatch(dev):
            continue
        if typ is not None and not SAFE_ARG_RE.fullmatch(str(typ)):
            continue
        out_.append((dev, str(typ) if typ else None))
    return out_


def smart_argv(cfg, dev, typ):
    return [path_of(cfg, "smartctl"), *SMART_ARGS, *(["-d", typ] if typ else []), dev]


def _smart_id(dev, typ):
    return f"{dev} [{typ}]" if typ and typ not in ("sat", "nvme", "scsi", "ata", "auto") else dev


def parse_smart(text):
    """smartctl -j output -> one drive. Always the JSON, never the exit code:
    the code is a bitmask (2 means "in standby, skipped"; 64 an error logged
    years ago), and a non-zero code very often carries a perfectly good read."""
    try:
        j = json.loads(text)
    except (json.JSONDecodeError, TypeError):
        return {"state": "error", "error": "smartctl did not answer in JSON (smartmontools 7+ is needed)"}
    msgs = " ".join(m.get("string", "") for m in (j.get("smartctl") or {}).get("messages", []) if isinstance(m, dict))
    if re.search(r"STANDBY|SLEEP|IDLE_B", msgs, re.I) and "smart_status" not in j:
        return {"state": "standby"}
    passed = (j.get("smart_status") or {}).get("passed")
    attrs = {a.get("id"): a for a in (j.get("ata_smart_attributes") or {}).get("table", []) if isinstance(a, dict)}

    def raw(i):
        a = attrs.get(i)
        return int((a.get("raw") or {}).get("value")) if a and isinstance((a.get("raw") or {}).get("value"), int) else None

    nvme = j.get("nvme_smart_health_information_log") or {}
    realloc = raw(5)
    if realloc is None and isinstance(j.get("scsi_grown_defect_list"), int):
        realloc = j["scsi_grown_defect_list"]
    drive = {
        "model": j.get("model_name") or j.get("scsi_model_name") or j.get("model_family") or None,
        "health": None if passed is None else ("passed" if passed else "failed"),
        "celsius": (j.get("temperature") or {}).get("current"),
        "hours": (j.get("power_on_time") or {}).get("hours"),
        "wear_pct": nvme.get("percentage_used"),
        "realloc": realloc,
        "pending": raw(197),
        "state": "active",
    }
    if drive["model"] is None and passed is None and not attrs and not nvme:
        drive["state"] = "error"
        drive["error"] = msgs[:200] or "smartctl could not read this drive"
    return drive


def read_smart(cfg, which="stalest"):
    """
    Refresh SMART readings: `which` is "stalest" (at most one drive, the one
    read longest ago, if it is older than 30 minutes — so a poll never pays for
    more than one), "all" (every drive older than 30 minutes) or "none".
    Returns (drives, error).
    """
    devs = smart_devices(cfg)
    if not devs:
        return [], None
    cached = cache_get("smart")
    now = time.time()
    stale = [(d, t) for d, t in devs if now - (cached.get(_smart_id(d, t)) or {}).get("t", 0) > SMART_MAX_AGE]
    if which == "stalest":
        stale.sort(key=lambda dt: (cached.get(_smart_id(*dt)) or {}).get("t", 0))
        stale = stale[:1]
    elif which == "none":
        stale = []
    updates = {}
    err = None
    for dev, typ in stale:
        rc, so, se = run(["sudo", "-n", *smart_argv(cfg, dev, typ)], timeout=25)
        if not so.strip() and _sudo_refused(se):
            err = "sudo refused smartctl: re-run the Sentinel installer"
            break
        reading = parse_smart(so)
        prev = cached.get(_smart_id(dev, typ)) or {}
        if reading.get("state") == "standby" and prev.get("drive"):
            kept = dict(prev["drive"])
            kept["state"] = "standby"
            updates[_smart_id(dev, typ)] = {"t": now, "drive": kept, "read_t": prev.get("read_t", now)}
        else:
            updates[_smart_id(dev, typ)] = {"t": now, "drive": reading, "read_t": now}
    if updates:
        cached = cache_merge("smart", updates)
    drives = []
    for dev, typ in devs:
        entry = cached.get(_smart_id(dev, typ))
        if not entry:
            continue
        d = {"device": _smart_id(dev, typ)}
        d.update(entry.get("drive") or {})
        d["age_s"] = int(now - entry.get("read_t", entry.get("t", now)))
        drives.append(d)
    return drives, err


