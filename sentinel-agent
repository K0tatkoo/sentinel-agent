# /proc sampling
# --------------------------------------------------------------------------- #

def read_cpu_jiffies():
    """Aggregate + per-core jiffy counters from /proc/stat."""
    cpus = {}
    with open(os.path.join(PROC, "stat")) as fh:
        for line in fh:
            if not line.startswith("cpu"):
                break
            parts = line.split()
            cpus[parts[0]] = [int(x) for x in parts[1:]]
    return cpus


def read_net_counters():
    counters = {}
    with open(os.path.join(PROC, "net/dev")) as fh:
        for line in fh.readlines()[2:]:
            name, _, rest = line.partition(":")
            f = rest.split()
            if len(f) >= 16:
                counters[name.strip()] = [int(f[0]), int(f[8])]     # rx, tx bytes
    return counters


def read_proc_cpu():
    """utime+stime per pid, for a real per-process CPU rate (not ps's average)."""
    procs = {}
    try:
        pids = [d for d in os.listdir(PROC) if d.isdigit()]
    except OSError:
        return procs
    for pid in pids:
        try:
            with open(os.path.join(PROC, pid, "stat")) as fh:
                data = fh.read()
            close = data.rfind(")")                # comm can contain spaces/parens
            comm = data[data.find("(") + 1:close]
            f = data[close + 2:].split()
            procs[pid] = (int(f[11]) + int(f[12]), comm)   # utime, stime
        except (OSError, ValueError, IndexError):
            continue
    return procs


def cpu_pct(prev, cur):
    """Busy share between two jiffy snapshots, per key."""
    result = {}
    for key, now in cur.items():
        before = prev.get(key)
        if not before or len(before) < 4:
            continue
        total = sum(now) - sum(before)
        idle = (now[3] + now[4]) - (before[3] + before[4])   # idle + iowait
        if total > 0:
            result[key] = max(0.0, min(100.0, 100.0 * (total - idle) / total))
    return result


def sample(iface_names):
    """
    CPU/net/process rates. Uses the cached previous sample when it is fresh
    enough to be meaningful, and otherwise pays for a real 300 ms second sample.
    Never falls back to a since-boot average.
    """
    now = time.time()
    prev = cache_get("sample") or None
    cur_cpu, cur_net, cur_procs = read_cpu_jiffies(), read_net_counters(), read_proc_cpu()

    age = now - prev["t"] if prev and "t" in prev else None
    if not prev or age is None or age < 0.4 or age > 120:
        time.sleep(0.3)
        base_cpu, base_net, base_procs = cur_cpu, cur_net, cur_procs
        base_t = now
        cur_cpu, cur_net, cur_procs = read_cpu_jiffies(), read_net_counters(), read_proc_cpu()
        now = time.time()
    else:
        base_cpu = prev.get("cpu", {})
        base_net = prev.get("net", {})
        base_procs = {k: (v, "") for k, v in prev.get("procs", {}).items()}
        base_t = prev["t"]

    window = max(0.05, now - base_t)
    pcts = cpu_pct(base_cpu, cur_cpu)
    cores = sorted(((k, v) for k, v in pcts.items() if k != "cpu"), key=lambda kv: int(kv[0][3:] or 0))

    hz = os.sysconf("SC_CLK_TCK")
    top = []
    for pid, (jiffies, comm) in cur_procs.items():
        before = base_procs.get(pid)
        if not before:
            continue
        delta = jiffies - before[0]
        if delta <= 0:
            continue
        top.append({"pid": int(pid), "name": comm, "cpu_pct": round(100.0 * delta / hz / window, 1)})
    top.sort(key=lambda p: -p["cpu_pct"])
    top = [p for p in top[:8] if p["cpu_pct"] >= 0.5]
    for p in top:
        try:
            with open(os.path.join(PROC, str(p["pid"]), "statm")) as fh:
                p["rss_mb"] = round(int(fh.read().split()[1]) * os.sysconf("SC_PAGE_SIZE") / 1048576, 1)
        except (OSError, ValueError, IndexError):
            p["rss_mb"] = None

    nets = []
    for name in iface_names:
        a, b = base_net.get(name), cur_net.get(name)
        if not a or not b:
            continue
        nets.append({
            "iface": name,
            "rx_bps": round(max(0, b[0] - a[0]) / window, 1),
            "tx_bps": round(max(0, b[1] - a[1]) / window, 1),
            "rx_total": b[0],
            "tx_total": b[1],
        })

    cache_put("sample", {"t": now, "cpu": cur_cpu, "net": cur_net,
                         "procs": {k: v[0] for k, v in cur_procs.items()}})
    return {
        "cpu_pct": round(pcts.get("cpu", 0.0), 1),
        "cores": [round(v, 1) for _, v in cores],
        "window_s": round(window, 2),
        "top": top,
        "net": nets,
    }


