def sudo_escape(arg):
    """One argument as sudoers needs it: , : = and \\ are special inside a
    Cmnd and must be backslashed (megaraid,0 would otherwise split the rule in
    two), and an empty argument list is written "" — a bare path means "with
    any arguments at all"."""
    return "".join("\\" + ch if ch in "\\,:=" else ch for ch in arg)


def sudo_command(argv):
    path, args = argv[0], argv[1:]
    return sudo_escape(path) + " " + (" ".join(sudo_escape(a) for a in args) if args else '""')


def sudo_argvs(cfg):
    """Every argv this agent will ever pass to sudo, for this config, labelled."""
    rules = []
    hw = cfg.get("hardware") or {}
    if cfg["containers"]:
        rules.append(("read", [path_of(cfg, "docker"), *DOCKER_PS]))
        rules.append(("read", [path_of(cfg, "docker"), *DOCKER_STATS]))
        for c in cfg["containers"]:
            if CONTAINER_RE.fullmatch(c):
                rules.append(("read", [path_of(cfg, "docker"), "logs", "--tail", str(LOG_TAIL), "--timestamps", c]))
    for u in cfg["units"]:
        if UNIT_RE.fullmatch(u):
            rules.append(("read", journal_argv(cfg, u)))
    if hw.get("ipmi"):
        rules.append(("read", [path_of(cfg, "ipmitool"), "sdr", "elist"]))
        rules.append(("read", [path_of(cfg, "ipmitool"), "sel", "elist", "last", str(SEL_TAIL)]))
    for dev, typ in smart_devices(cfg):
        rules.append(("read", smart_argv(cfg, dev, typ)))
    if cfg.get("allow_control"):
        for u in control_units(cfg):
            for verb in unit_verbs(u):
                rules.append(("control", [path_of(cfg, "systemctl"), verb, u]))
        for c in control_containers(cfg):
            for verb in ACTIONS:
                rules.append(("control", [path_of(cfg, "docker"), verb, c]))
        for key, spec in sorted(check_control_specs(cfg).items()):
            verbs, _c, _h = check_control(cfg, key)
            unit = spec.get("unit")
            for verb in verbs:
                if isinstance(unit, str):
                    rules.append(("control", [path_of(cfg, "systemctl"), *UNIT_CHECK_VERBS[verb], unit]))
                else:
                    rules.append(("control", list(spec["commands"][verb])))
    seen, unique = set(), []
    for kind, argv in rules:
        t = tuple(argv)
        if t not in seen:
            seen.add(t)
            unique.append((kind, argv))
    return unique


def _sudo_version():
    rc, so, _ = run(["sudo", "-V"], timeout=5)
    m = re.search(r"Sudo version (\d+)\.(\d+)\.(\d+)", so or "")
    return tuple(int(x) for x in m.groups()) if m else (0, 0, 0)


def sudoers_text(cfg, user, quiet_logs=None):
    """The whole drop-in for /etc/sudoers.d/sentinel-agent."""
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", user or ""):
        raise ValueError(f"not a user name sudoers can hold: {user!r}")
    rules = sudo_argvs(cfg)
    reads = [sudo_command(a) for k, a in rules if k == "read"]
    controls = [sudo_command(a) for k, a in rules if k == "control"]
    lines = [
        "# Written by sentinel-agent --sudoers. Do not edit: re-run the Sentinel installer instead.",
        "# Each entry is one exact command line the agent runs; nothing else is allowed.",
    ]
    if reads:
        lines.append("Cmnd_Alias SENTINEL_READ = " + ", \\\n    ".join(reads))
        lines.append(f"{user} ALL=(root) NOPASSWD: SENTINEL_READ")
    if controls:
        lines.append("Cmnd_Alias SENTINEL_CONTROL = " + ", \\\n    ".join(controls))
        lines.append(f"{user} ALL=(root) NOPASSWD: SENTINEL_CONTROL")
    if quiet_logs is None:
        quiet_logs = _sudo_version() >= (1, 9, 8)
    if reads and quiet_logs:
        # The app reads every few seconds. Logging each of those would bury
        # everything else in the auth log; control actions are still logged.
        lines.append("Defaults!SENTINEL_READ !log_allowed, !pam_session")
    return "\n".join(lines) + "\n"


